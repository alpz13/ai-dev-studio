# Copy this file to .env and fill in your API key.
# Get one at https://console.anthropic.com (or wherever your organization manages it).
ANTHROPIC_API_KEY=

# Optional: model id to use. If left empty, src/core/client.ts uses a
# built-in default — but it's worth pinning it here and checking the current id at
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=

# Optional: folder where feature state lives (Feature State MCP).
# Defaults to ./features
FEATURES_DIR=

# Required: shared bearer token the web UI/API checks on every request
# (except /healthz). Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTH_TOKEN=
