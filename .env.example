# Copia este archivo a .env y completa tu API key.
# Consíguela en https://console.anthropic.com (o donde tu organización la administre).
ANTHROPIC_API_KEY=

# Opcional: id de modelo a usar. Si lo dejas vacío, src/core/client.ts usa un
# default embebido — pero conviene fijarlo aquí y revisar el id vigente en
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=

# Opcional: carpeta donde vive el estado de las features (Feature State MCP).
# Por default es ./features
FEATURES_DIR=
