{
  "name": "ai-dev-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Simulated software development studio run by AI agents — a practice project for the Anthropic stack (TS SDK, Messages API, MCP, agents, multi-agent, subagents).",
  "type": "module",
  "scripts": {
    "test:store": "tsx scripts/__tests__/test-feature-state-store.ts",
    "mcp:feature-state": "tsx src/mcp-servers/feature-state/server.ts",
    "test:mcp-client": "tsx scripts/__tests__/test-feature-state-client.ts",
    "test:mcp-director": "tsx scripts/__tests__/test-director-mcp-client.ts",
    "test:core": "tsx scripts/__tests__/test-core.ts",
    "test:fs-git": "tsx scripts/__tests__/test-filesystem-git-ops.ts",
    "test:trace-logger": "tsx scripts/__tests__/test-trace-logger.ts",
    "test:agent-helpers": "tsx scripts/__tests__/test-agent-loop-helpers.ts",
    "mcp:filesystem-git": "tsx src/mcp-servers/filesystem-git/server.ts",
    "mcp:director": "tsx src/mcp-servers/director/server.ts",
    "agent:dev": "tsx scripts/run-dev-agent.ts",
    "studio": "tsx scripts/run-studio.ts",
    "web": "tsx scripts/run-web.ts",
    "trace-summary": "tsx scripts/trace-summary.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
